# Server
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000
MCP_HTTP_PATH=/

# Auth mode: "oauth" or "query"
MCP_AUTH_MODE=oauth

# Public URL (must match your Cloudflare Tunnel domain)
MCP_BASE_URL=https://mcp.yourdomain.ca

# JWT secret — change this to a random string!
MCP_JWT_SECRET=change-me-now

# Login credentials for the /authorize page (username:password)
# Multiple users: comma-separated
MCP_AUTH_USERS=admin:changeme,user2:pass2

# Rate limiting (requests per window)
MCP_RATE_LIMIT_MAX=30
MCP_RATE_LIMIT_WINDOW=60

# Token expiry in seconds (default 1 hour)
MCP_JWT_EXPIRE_SECONDS=1209600
